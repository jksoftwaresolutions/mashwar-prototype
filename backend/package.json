{
  "name": "@mashwar/backend",
  "version": "0.1.0",
  "private": true,
  "description": "MASHWAR backend (NestJS modular monolith). Phase 1 foundation: config, health, migrations, domain rules.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:db": "jest --config jest.db.config.js --runInBand",
    "db:migrate": "node -r ts-node/register db/migrate.ts",
    "db:seed:dev": "node -r ts-node/register db/migrate.ts --seed-dev"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3"
  }
}
