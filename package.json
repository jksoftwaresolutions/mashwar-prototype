{
  "name": "mashwar",
  "private": true,
  "description": "MASHWAR ride-hailing platform monorepo: prototype, backend, admin, mobile (Dart workspace)",
  "scripts": {
    "prototype:dev": "pnpm --filter mashwar-prototype dev",
    "prototype:check": "pnpm --filter mashwar-prototype check",
    "prototype:e2e": "pnpm --filter mashwar-prototype test:e2e",
    "backend:dev": "pnpm --filter @mashwar/backend start:dev",
    "backend:test": "pnpm --filter @mashwar/backend test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @mashwar/backend db:migrate",
    "admin:dev": "pnpm --filter @mashwar/admin dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "packageManager": "pnpm@10.34.3",
  "engines": { "node": ">=22" }
}
